<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FFXIV_ACT_Plugin.Common</AssemblyName>
    <RootNamespace>FFXIV_ACT_Plugin.Common</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- host process assembly: compile-time reference only, never
         copied next to the plugin nor woven in by Costura -->
    <PackageReference Include="AdvancedCombatTracker" Version="3.8.4.287">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
