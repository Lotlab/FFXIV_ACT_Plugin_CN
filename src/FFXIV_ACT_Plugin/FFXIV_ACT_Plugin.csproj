<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FFXIV_ACT_Plugin</AssemblyName>
    <RootNamespace>FFXIV_ACT_Plugin</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\machina\Machina.FFXIV\Machina.FFXIV.csproj" />
    <ProjectReference Include="..\..\third_party\machina\Machina\Machina.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Network\FFXIV_ACT_Plugin.Network.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stripped and CN-patched upstream assemblies; see tools/prepare_upstream.py. -->
    <Reference Include="FFXIV_ACT_Plugin.Common"><HintPath>$(UpstreamDir)FFXIV_ACT_Plugin.Common.dll</HintPath></Reference>
    <Reference Include="FFXIV_ACT_Plugin.Config"><HintPath>$(UpstreamDir)FFXIV_ACT_Plugin.Config.dll</HintPath></Reference>
    <Reference Include="FFXIV_ACT_Plugin.Logfile"><HintPath>$(UpstreamDir)FFXIV_ACT_Plugin.Logfile.dll</HintPath></Reference>
    <Reference Include="FFXIV_ACT_Plugin.Memory"><HintPath>$(UpstreamDir)FFXIV_ACT_Plugin.Memory.dll</HintPath></Reference>
    <Reference Include="FFXIV_ACT_Plugin.Parse"><HintPath>$(UpstreamDir)FFXIV_ACT_Plugin.Parse.dll</HintPath></Reference>
    <Reference Include="FFXIV_ACT_Plugin.Resource"><HintPath>$(UpstreamDir)FFXIV_ACT_Plugin.Resource.dll</HintPath></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- host process assembly: compile-time reference only, never
         copied next to the plugin nor woven in by Costura -->
    <PackageReference Include="AdvancedCombatTracker" Version="3.8.4.287">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Single-file packaging: Costura.Fody weaves every copy-local dependency (the
      six stripped/patched upstream assemblies, this repository's Network and
      Unscrambler outputs, Machina, Machina.FFXIV, Newtonsoft.Json and
      WindowsFirewallHelper) into FFXIV_ACT_Plugin.dll as `costura.*.compressed`
      resources, and injects the assembly resolver that loads them at runtime.
    -->
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Stage the deployable plugin folder.

    The managed plugin is one self-contained DLL, but that is not the whole story:
    Machina.FFXIV's DeucalionInjector loads a native `deucalion-<version>.dll` from the
    plugin folder at runtime, and this build of the plugin has no updater that could
    fetch one (ACT_PluginUpdate.UpdateCheckClicked_Version is empty in the CN build).
    prepare_upstream.py unpacks them from the pinned upstream release, so their bytes are
    anchored by upstream/lock.json's sha256 rather than by whichever machina revision
    happens to be checked out.
  -->
  <Target Name="StagePluginFolder" AfterTargets="Build">
    <PropertyGroup>
      <PluginStageDir>$(RepoRoot)artifacts\dist\$(Configuration)\</PluginStageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PluginStageDir)" />
    <MakeDir Directories="$(PluginStageDir)" />
    <ItemGroup>
      <!-- unpacked from the pinned upstream release by tools/prepare_upstream.py -->
      <DeucalionPayload Include="$(UpstreamDir)deucalion-*.dll" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginStageDir)" />
    <Copy SourceFiles="@(DeucalionPayload)" DestinationFolder="$(PluginStageDir)"
          Condition="'@(DeucalionPayload)' != ''" />
    <Message Importance="high" Text="Plugin staged: $(PluginStageDir)" />
  </Target>
</Project>
