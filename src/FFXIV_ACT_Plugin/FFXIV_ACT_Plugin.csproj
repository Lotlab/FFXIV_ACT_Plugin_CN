<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FFXIV_ACT_Plugin</AssemblyName>
    <RootNamespace>FFXIV_ACT_Plugin</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Common\FFXIV_ACT_Plugin.Common.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Config\FFXIV_ACT_Plugin.Config.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Logfile\FFXIV_ACT_Plugin.Logfile.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Memory\FFXIV_ACT_Plugin.Memory.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Network\FFXIV_ACT_Plugin.Network.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Parse\FFXIV_ACT_Plugin.Parse.csproj" />
    <ProjectReference Include="..\FFXIV_ACT_Plugin.Resource\FFXIV_ACT_Plugin.Resource.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(RefsDir)Advanced Combat Tracker.exe</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <!-- host assembly: never copy or embed -->
      <Private>false</Private>
    </Reference>
    <Reference Include="Machina">
      <HintPath>$(RefsDir)Machina.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>true</Private>
    </Reference>
    <Reference Include="Machina.FFXIV">
      <HintPath>$(RefsDir)Machina.FFXIV.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="FFXIV_ACT_Plugin.BenchmarkPropertyPage.resources" LogicalName="FFXIV_ACT_Plugin.BenchmarkPropertyPage.resources" />
    <EmbeddedResource Include="FFXIV_ACT_Plugin.SettingsPropertyPage.resources" LogicalName="FFXIV_ACT_Plugin.SettingsPropertyPage.resources" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Single-file packaging: Costura.Fody weaves every copy-local dependency (the
      seven FFXIV_ACT_Plugin.* project outputs, Machina, Machina.FFXIV and the
      transitively required Newtonsoft.Json) into FFXIV_ACT_Plugin.dll as
      `costura.*.compressed` resources, and injects the assembly resolver that loads
      them at runtime.  This is how the shipped plugin was built.
    -->
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Stage the woven DLL on its own, so the single-file deliverable is not mixed in
    with the sibling project outputs that share artifacts/bin.  This directory is
    exactly what gets copied into ACT's plugin folder (plus the deucalion DLLs).
  -->
  <Target Name="StageSingleFilePlugin" AfterTargets="Build">
    <PropertyGroup>
      <SingleFileStageDir>$(RepoRoot)artifacts\dist\$(Configuration)\</SingleFileStageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(SingleFileStageDir)" />
    <MakeDir Directories="$(SingleFileStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SingleFileStageDir)" />
    <Message Importance="high" Text="Single-file plugin staged: $(SingleFileStageDir)$(TargetFileName)" />
  </Target>
</Project>
