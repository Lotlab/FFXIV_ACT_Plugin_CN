<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FFXIV_ACT_Plugin</AssemblyName>
    <RootNamespace>FFXIV_ACT_Plugin</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ActAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FFXIV_ACT_Plugin.Common/FFXIV_ACT_Plugin.Common.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Config/FFXIV_ACT_Plugin.Config.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Logfile/FFXIV_ACT_Plugin.Logfile.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Memory/FFXIV_ACT_Plugin.Memory.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Network/FFXIV_ACT_Plugin.Network.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Parse/FFXIV_ACT_Plugin.Parse.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Resource/FFXIV_ACT_Plugin.Resource.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Machina is built from third_party/machina (Lotlab fork,
         feature/oodle-state-recovery) and embedded by Costura like the rest. -->
    <ProjectReference Include="../../third_party/machina/Machina/Machina.csproj" />
    <ProjectReference Include="../../third_party/machina/Machina.FFXIV/Machina.FFXIV.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>

</Project>
