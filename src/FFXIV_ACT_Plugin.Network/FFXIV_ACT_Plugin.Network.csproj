<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FFXIV_ACT_Plugin.Network</AssemblyName>
    <RootNamespace>FFXIV_ACT_Plugin.Network</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FFXIV_ACT_Plugin.Common/FFXIV_ACT_Plugin.Common.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Config/FFXIV_ACT_Plugin.Config.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Logfile/FFXIV_ACT_Plugin.Logfile.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Memory/FFXIV_ACT_Plugin.Memory.csproj" />
    <ProjectReference Include="../FFXIV_ACT_Plugin.Resource/FFXIV_ACT_Plugin.Resource.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Machina: see stage 1 - the upstream 2.4.7.1/2.3.1.3 binaries that the
         reference build embedded, kept in lib/ until they are replaced by the
         Lotlab fork. -->
    <Reference Include="Machina">
      <HintPath>$(ActReferenceDir)/machina/Machina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Machina.FFXIV">
      <HintPath>$(ActReferenceDir)/machina/Machina.FFXIV.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
