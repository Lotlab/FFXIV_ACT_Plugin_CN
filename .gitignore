# --- build output -----------------------------------------------------------
artifacts/
*.binlog

# --- reference assemblies (produced by tools/fetch_references.py) -----------
# This repository intentionally contains no binaries: the four compile-time
# reference assemblies are materialised on demand, see README section 2.
refs/
reference/

# --- decompiler working tree ------------------------------------------------
# .work/ holds the assemblies unpacked from reference/ and the raw ilspycmd
# output.  It is fully reproducible with tools/decompile.py.
.work/

# --- Visual Studio / Rider --------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userprefs

# --- NuGet ------------------------------------------------------------------
packages/
*.nupkg

# --- Rust (third_party/deucalion) -------------------------------------------
third_party/deucalion/*/target/

# --- submodule build output (third_party/machina) ---------------------------
third_party/machina/*/bin/
third_party/machina/*/obj/

# --- Python tooling ---------------------------------------------------------
__pycache__/
*.py[cod]

# --- misc -------------------------------------------------------------------
*.log
