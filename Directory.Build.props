<Project>

  <!--
    Shared build settings for every project in the reconstructed source tree.

    The decompiled assemblies all target .NET Framework 4.8, which is what
    Advanced Combat Tracker 3.x runs on.  LangVersion is pinned to `latest`; the
    decompiler emitted file-scoped namespaces and other modern syntax.
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <RefsDir>$(RepoRoot)refs\</RefsDir>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <!--
    Funnel every project's output into one folder so the built plugin can be
    dropped straight into Advanced Combat Tracker's plugin directory.
  -->
  <PropertyGroup>
    <BaseOutputPath>$(RepoRoot)artifacts\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    This repository holds no binaries, so refs/ is produced on demand by
    tools/fetch_references.py.  Fail early with something actionable instead of
    letting every <Reference> silently fail to resolve.
  -->
  <Target Name="EnsureReferenceAssemblies" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(NeedsPluginReferences)' != 'false'">
    <Error Condition="!Exists('$(RefsDir)Advanced Combat Tracker.exe')"
           Code="DSH0001"
           Text="Reference assemblies are missing from $(RefsDir). Run: python tools/fetch_references.py  (see README section 2)." />
  </Target>

</Project>
